<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.chunfeng.mapper.RoleMapper">
    <sql id="roleSql">
        select id, name, create_user, create_time, update_user, update_time, deleted
        from role
        <where>
            <if test="role.name!='' and role.name!=null">
                name like concat('%',#{role.name},'%')
            </if>
            and deleted=0
        </where>
        order by create_time desc,update_time desc
    </sql>
    <!--分页查询-->
    <select id="selectRouterPage" resultType="com.chunfeng.entity.Role">
        <include refid="roleSql"/>
    </select>
    <!--按条件记录角色的个数-->
    <select id="countAllRoleByCondition" resultType="java.lang.Integer">
        select COUNT(id)
        from role
        <where>
            <if test="role.name!='' and role.name!=null">
                name=#{role.name}
            </if>
            and deleted=0
        </where>
    </select>
    <!--分页查询-->
    <select id="selectRouter" resultType="com.chunfeng.entity.Role">
        <include refid="roleSql"/>
    </select>
</mapper>