<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.chunfeng.mapper.PermissionRouterMapper">
    <!--绑定关系信息-->
    <insert id="insertPermissionRouter">
        insert into permission_router (id,permission_id, router_id, create_user, create_time, update_user, update_time)
        <foreach collection="prs" item="pr" open="values" separator="," close=";">
            (#{pr.id},#{pr.permissionId},#{pr.routerId},#{pr.createUser},#{pr.createTime},#{pr.updateUser},#{pr.updateTime})
        </foreach>
    </insert>
    <!--重新激活已被删除的关系数据-->
    <update id="enablePermissionRouterFromDeleted">
        update permission_router set deleted=0
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            router_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.routerId}
            </foreach>
            and deleted=1
        </where>
    </update>
    <!--根据关系批量解绑关系信息-->
    <delete id="deletePermissionRouterByCondition">
        update permission_router set deleted=1
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            router_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.routerId}
            </foreach>
            and deleted=0
        </where>
    </delete>
    <!--根据ID批量解绑关系信息-->
    <delete id="deletePermissionRouterByIds">
        update permission_router set deleted=1
        <where>
            id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            and deleted=0
        </where>
    </delete>
    <!--根据路由ID查询绑定的关系数据-->
    <select id="selectPermissionRouterByRouter" resultType="java.lang.Long">
        select pr.id
        from permission_router pr
        left join router r on r.id = pr.router_id
        <where>
            r.id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            and pr.deleted=0
            and r.deleted=0
        </where>
    </select>
    <!--记录关系数据中已经失效的数据-->
    <select id="selectPermissionRouterFromDeleted" resultType="com.chunfeng.entity.PermissionRouter">
        select permission_id,router_id
        from permission_router
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            router_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.routerId}
            </foreach>
            and deleted=1
        </where>
    </select>
    <!--根据权限ID查询绑定的关系数据-->
    <select id="selectPermissionRouterByPermission" resultType="java.lang.Long">
        select pr.id
        from permission_router pr
        left join permission p on pr.permission_id = p.id
        <where>
            p.id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            and pr.deleted=0
            and p.deleted=0
        </where>
    </select>
    <!--根据权限与路由ID查询关系数据-->
    <select id="selectPermissionRouterByIds" resultType="com.chunfeng.entity.PermissionRouter">
        select id
        from permission_router
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            router_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.routerId}
            </foreach>
            and deleted=0
        </where>
    </select>
</mapper>