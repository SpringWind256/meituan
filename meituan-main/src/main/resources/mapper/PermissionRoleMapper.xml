<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.chunfeng.mapper.PermissionRoleMapper">
    <!--根据权限ID查询关系数据-->
    <select id="selectPermissionRoleByPermission" resultType="com.chunfeng.entity.PermissionRole">
        select id,
        permission_id,
        role_id,
        create_user,
        create_time,
        update_user,
        update_time,
        deleted
        from permission_role
        <where>
            permission_id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            and deleted=0
        </where>
    </select>
    <!--根据角色ID查询关系数据-->
    <select id="selectPermissionRoleByRole" resultType="com.chunfeng.entity.PermissionRole">
        select id,
        permission_id,
        role_id,
        create_user,
        create_time,
        update_user,
        update_time,
        deleted
        from permission_role
        <where>
            role_id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            and deleted=0
        </where>
    </select>
    <!--根据权限与角色ID确定关系列表并记录个数-->
    <select id="selectPermissionRoleByIds" resultType="com.chunfeng.entity.PermissionRole">
        select permission_id,role_id
        from permission_role
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            role_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.roleId}
            </foreach>
            and deleted=0
        </where>
    </select>
    <!--查询已删除的关系数据-->
    <select id="selectPermissionRoleFromDeleted" resultType="com.chunfeng.entity.PermissionRole">
        select permission_id,role_id
        from permission_role
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            role_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.roleId}
            </foreach>
            and deleted=1
        </where>
    </select>
    <!--批量新增关系数据-->
    <insert id="insertPermissionRole">
        insert into permission_role (id,permission_id, role_id, create_user, create_time, update_user, update_time)
        <foreach collection="prs" item="pr" open="values" separator="," close=";">
            (#{pr.id},#{pr.permissionId},#{pr.roleId},#{pr.createUser},#{pr.createTime},#{pr.updateUser},#{pr.updateTime})
        </foreach>
    </insert>
    <!--重新激活已被删除的关系数据-->
    <update id="enablePermissionRoleFromDeleted">
        update permission_role set deleted=0
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            role_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.roleId}
            </foreach>
            and deleted=1
        </where>
    </update>
    <!--批量删除关系数据-->
    <delete id="deletePermissionRole">
        update permission_role set deleted=1
        <where>
            permission_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.permissionId}
            </foreach>
            and
            role_id in
            <foreach collection="prs" item="pr" open="(" separator="," close=")">
                #{pr.roleId}
            </foreach>
            and deleted=0
        </where>
    </delete>
    <!--批量删除关系数据-->
    <delete id="deletePermissionRoleById">
        update permission_role set deleted=1
        <where>
            id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            and deleted=0
        </where>
    </delete>
</mapper>