<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <packaging>pom</packaging>
    <groupId>com.chunfeng</groupId>
    <artifactId>meituan-parent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <modules>
        <module>meituan-dependencies</module>
        <module>meituan-main</module>
    </modules>

    <properties>
        <project.version>1.0-SNAPSHOT</project.version>
        <maven.encoding>UTF-8</maven.encoding>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--插件-->
        <maven-plugin.version>3.8.1</maven-plugin.version>
        <spring-plugin.version>3.2.5</spring-plugin.version>
        <maven-resources-plugin>3.3.1</maven-resources-plugin>
        <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
        <!--<docker.host>http://linux:2375</docker.host>-->
        <docker-maven-plugin.version>0.40.2</docker-maven-plugin.version>
        <javadoc-plugin.version>3.10.1</javadoc-plugin.version>
        <maven-source-plugin.version>3.2.1</maven-source-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.chunfeng</groupId>
                <artifactId>metuan-dependencies</artifactId>
                <version>${version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>